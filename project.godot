; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="高中异闻：尖塔"
config/version="0.2.0"
config/description="高中异闻：尖塔 0.2.0"
run/main_scene="res://scenes/tower/tower.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="InkSpire"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/graphics/tower/app-icon.webp"

[autoload]
TowerMobile="*res://scripts/ui/tower_mobile.gd"

Settings="*res://scripts/autoload/settings.gd"
GameState="*res://scripts/autoload/game_state.gd"
Inventory="*res://scripts/autoload/inventory.gd"
Currency="*res://scripts/autoload/currency.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
Voice="*res://scripts/autoload/voice.gd"
Music="*res://scripts/autoload/music.gd"
DialogueBox="*res://scenes/ui/dialogue_box.tscn"
Backpack="*res://scripts/ui/backpack_panel.gd"
Shop="*res://scripts/ui/shop_panel.gd"
PlateGame="*res://scripts/minigames/plate_sort_game.gd"
SceneRouter="*res://scripts/autoload/scene_router.gd"
GameFlow="*res://scripts/autoload/game_flow.gd"
FightSystem="*res://scripts/autoload/fight_system.gd"
TowerRun="*res://scripts/autoload/tower_run.gd"
SpiritSystem="*res://scripts/autoload/spirit_system.gd"
NightTasks="*res://scripts/ui/highschool_night_tasks.gd"
StoryJump="*res://scripts/tower/story_jump_stub.gd"

[display]
window/handheld/orientation=0

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

