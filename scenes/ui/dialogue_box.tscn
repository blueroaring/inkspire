[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/ui/dialogue_box.gd" id="1_dlg"]

; 说明：这里只描述**节点结构**，所有样式（配色/描边/字号/圆角）由
; scripts/ui/dialogue_style.gd 在运行时套上去 —— 换风格只改那一个文件。
; 版式是 LingChat 风格的 galgame 全宽框：底部渐变遮罩 + 贴底对话框 +
; 左侧立绘位 + 名牌/情绪标签 + 逐字上浮的正文 + 右下"继续"指示三角。
;
; ⚠️ 对话框本体全部塞在 BoxRoot 下：hide_box() 只隐藏 BoxRoot，
;    而不是隐藏整个 CanvasLayer —— 否则"对话回顾"面板会被一起藏掉，
;    表现是"面板状态明明是开的，屏幕上却什么都没有"（这个坑真踩过）。

[node name="DialogueBox" type="CanvasLayer"]
layer = 40
script = ExtResource("1_dlg")

[node name="BoxRoot" type="Node2D" parent="."]

[node name="Backdrop" type="ColorRect" parent="BoxRoot"]
color = Color(0, 0, 0, 0.16)

[node name="Shade" type="TextureRect" parent="BoxRoot"]
expand_mode = 1
stretch_mode = 0
mouse_filter = 2

[node name="PhotoOverlay" type="TextureRect" parent="BoxRoot"]
visible = false
z_index = 2
expand_mode = 1
stretch_mode = 5
mouse_filter = 2

[node name="Bust" type="TextureRect" parent="BoxRoot"]
visible = false
expand_mode = 1
stretch_mode = 5
mouse_filter = 2

[node name="Window" type="PanelContainer" parent="BoxRoot"]
z_index = 3

[node name="HBox" type="HBoxContainer" parent="BoxRoot/Window"]
layout_mode = 2
theme_override_constants/separation = 26

[node name="PortraitFrame" type="PanelContainer" parent="BoxRoot/Window/HBox"]
