## 对话补丁 id = `cg.alyina_fall.landing`（在对话编辑器里单独一段，改词不用动源码）。
static func alyina_landing_lines() -> Array:
	return [
		{"speaker": "周明远", "text": "毕业论文少写一天不少，多写一天不多，就先带你逛逛校园吧。",
			"emotion": "想通"},
		{"speaker": "艾莉娜", "text": "哇，感谢粥粥愿意带我去玩！", "emotion": "欢呼"},
		{"speaker": "周明远",
			"text": "（笑）也算是我第一次在大学和女生（?）一起逛街吧。我在大学还没有谈过女朋友呢。",
			"emotion": "自嘲"},
	]
