class_name CgData
extends RefCounted
## CG 剧情数据（开头那段 CG 的镜头表）。
##
## 现在内容是占位的（用户说"还没想好，先做一个随便的 CG 模板框架"），
## 但镜头表结构已经是正式的：以后只替换这里的文字与图片路径，模板不用改。
##
## 图片路径约定：res://assets/graphics/cg/<名字>.png
## 图片不存在时模板会自动退回纯色 + 旁白，所以现在不阻塞任何后续工作。

const CG_DIR := "res://assets/graphics/cg/"

## 音效：开场 CG1 末尾那声"滋啦"（`tools/generate_sfx.py` 生成的占位素材，可随时替换）。
## 缺文件时 `CgPlayer` 只是不发声，不会打断 CG（与"没有图也能跑"同一条纪律）。
const SFX_STATIC := "res://assets/audio/sfx/cg_static.wav"

## 音效：被砸中那声闷响（08 的 cg3「咚！」）
const SFX_IMPACT := "res://assets/audio/sfx/cg_impact.wav"


## 开场 CG：`request/08_DIALOG.md` 的 CG1 + CG2 + CG3。
##
## 镜头顺序（与 08 的三段一一对应）：
##   CG1  空灵的女声浮出：「勿忘……我」「找到……我」「最后……拯救我」，闪屏 + 滋啦声消失
##   CG2  黑屏，主角自我介绍（"我叫周明远。是一所普通大学的大四学生……"）
##   CG3  醒来（对话框 · 周明远），桌上手机屏幕还亮着 —— 交给宿舍场景里的"按 E 捡起手机"
##
## ⚠️ **手机的时间（12:04）不在这里拨**：CG 只负责"说"，时间由
##    `ItemActions.PHONE_FIRST_LOOK`（玩家真的按 B 用手机那一下）设。
##    本段的第一句旁白就是 08 里的"旁白：手机就放在桌面上，屏幕还亮着。"
##
## ⚠️ **CG1/CG2 走 `blackout`（黑底白字的过场字幕），不走对话框**。
##    用户 2026-09-20 明确："开场的 cg1 应该都是黑底白字类型的，且过一会要过较长时间。"
##    对话框那套是贴底 galgame 版式（立绘位 + 名牌 + 底部按键提示），
##    演"空灵的女声"会读成"游戏里有人在跟你说话"；而且每一句都要玩家按键才走，
##    快慢由玩家决定、拖不出"过一会"的节奏。`blackout` 走 `NarrationBox`：
##    全屏黑底、白字居中、逐字浮出，然后**按 `hold` 停住**（键盘可提前跳过）。
##    停留时长写在每一句上：普通话 2.4s，最后那句"拯救我"给足 3.4s。
##
## ⚠️ 美术说明（2026-09-20 接图，方案 A）：
##   · CG1 的三句白字**直接压在** `alyina_drowning.png` 上（**女主在很深的水里往下沉**，
##     那三句"勿忘我/找到我/拯救我"就是从水底传来的）。
##     ⚠️ 画的是**人形的李安雅**，不是小精灵艾莉娜（用户 2026-09-20 明确）：
##        开场就把艾莉娜画进水里等于剧透"她是谁、从哪来"。
##     ⚠️ 这张图属于**开场**，**别挪去艾莉娜登场那一段**（用户纠正过一次）。
##   · 用户 2026-09-20 在三种接法里选了 **A：白字压在图上**（先试过"先纯黑读完、再淡入水底"，
##     那是方案 B；C 是 B 去掉旁白）。选 A 的底气是实测：那张图**中间带均亮 0.28、
##     最亮 0.97**，而字幕是白字 + 10px 黑描边（`NarrationBox`），对比度够。
##   · `fade` 给到 1.8s：图要**先于**第一句字浮出来，否则字会浮在黑屏上（那就白接图了）。
##     `blackout` 的第一句是在淡入**之后**才开始的，所以这个数不能太小。
##   · 开场所需的 `intro_phone_glow.png` / `intro_dorm_wide.png` 已补齐；启动自检会核对它们能否加载。
static func intro() -> Array:
	return [
		{
			"shot_name": "CG1 · 空灵的女声",
			# 背景＝女主沉入海底（方案 A）：三句白字压在这张图上。
			"bg": CG_DIR + "alyina_drowning.png",
			# ⚠️ **这一条不能漏**：字幕模板自带一层"全屏黑底"（它原本是给黑底白字用的），
			#    不声明 `blackout_over_art` 的话那层纯黑会把这张图**整个盖住** ——
			#    表现就是"先看到图、图消失、字才出来"（用户 2026-09-20 实报）。
			#    声明之后黑底改成压暗（`NarrationBox.ART_BG_ALPHA`），图透出来、字仍清楚。
			"blackout_over_art": true,
			"blackout": [
				{"speaker": "（空灵的女声）", "text": "勿忘……我", "hold": 2.6},
				{"speaker": "（空灵的女声）", "text": "找到……我", "hold": 2.6},
				{"speaker": "（空灵的女声）", "text": "最后……拯救我", "hold": 3.4},
			],
			"fade": 1.8,
			# 三句读完**让图再单独留一会**（否则闪屏镜头一来，图就没了）：
			# 用户要的是"字幕在图存在时显现"，那图上就该既有字、也有只有图的余味。
			"hold": 2.0,
		},
		{
			# 08 原文："CG1闪屏消失，伴有滋啦的音效"
			"shot_name": "CG1 · 闪屏消失（滋啦）",
			"bg": Color(0.92, 0.92, 0.96),
			"sfx": SFX_STATIC,
			"hold": 0.30,
			"fade": 0.08,
			"flash": true,
		},
		{
			"shot_name": "CG2 · 黑屏 · 自我介绍",
			"bg": Color(0.0, 0.0, 0.0),
			# CG2 是"黑屏，不需要图"（08 原文），所以同样用黑底白字字幕；
			# 这一句是主角的自述，停 3.4s 让玩家读完。
			"blackout": [
				{"text": "我叫周明远。是一所普通大学的大四学生，每天过着平凡而颓废的生活。",
					"hold": 3.4},
			],
			"fade": 0.6,
		},
		{
			# 08："旁白：手机就放在桌面上，屏幕还亮着。"（CG3 的收尾）
			"shot_name": "手机屏幕还亮着",
			"bg": CG_DIR + "intro_phone_glow.png",
			"fg": null,
			"text": "手机就放在桌面上，屏幕还亮着。",
			"hold": 1.2,
		},
		{
			# 纯过渡镜头：CG 结束时要交回宿舍场景（`intro_cg.gd` 的 NEXT_LOCATION）。
			# 素材缺了会自动退回纯色（`_apply_layer`），所以这里可以现在就写路径。
			"shot_name": "宿舍 · 全景",
			"bg": CG_DIR + "intro_dorm_wide.png",
			"slides": [
				{"duration": 1.4},
			],
			"text": "—— 这是周明远大学最后一年的普通一天。",
			"hold": 0.8,
		},
		{
			"shot_name": "CG3 · 醒来",
			"bg": Color(0.10, 0.10, 0.14),
			"dialogue": [
				{"speaker": "周明远", "text": "……几点了。", "emotion": "迷糊"},
				{"speaker": "周明远", "text": "头有点沉。昨天在图书馆写论文太耗精力了。", "emotion": "发沉"},
				{"speaker": "周明远", "text": "要不是为了那个毕业证，谁大四了还这么努力……", "emotion": "无奈"},
				{"speaker": "周明远", "text": "也怪自己大学玩了四年，什么也没学会。", "emotion": "沉默"},
				{"speaker": "周明远", "text": "算了，先刷下手机吧。", "emotion": "叹气"},
			],
		},
	]


## 艾莉娜登场 CG（用户 2026-09-19 `request/01_GOALS.md`）：
##   主角翘掉下午两点的毕业论文写作课、走出教学楼的那一刻，被天上掉下来的东西砸晕；
##   醒来时遇到同样晕乎乎的小精灵，她自称"艾莉娜"……
##
## 触发链：`TeachingData.exit_door()`（带 `story_flag`）→ `StoryDoor` →
##        `cg.alyina_fall`（本数据）→ 回 `college.campus_teaching` 的教学楼门口。
##
## ⚠️ **这一段 CG 结束后必须留下进度**，而"写在台词行上的 flag"会被跳过键吃掉
##    （见 `cg_player.gd::finish_flags` 的说明）—— 所以那两个开关写在
##    `scenes/boot/alyina_cg.tscn` 的 CgPlayer 上，不写在这里的台词里。
##
## 美术说明：图片从 2026-09-20 起接上：
##   · "天上掉下来的东西" → `CG_DIR + "alyina_fall_object.png"`（08 的 cg2）
##   · "被砸中"           → `CG_DIR + "alyina_impact.png"`（08 的 cg3）
##   · "被砸后缓过来"     → `CG_DIR + "alyina_recover.png"`（模糊睁眼过渡）
##   · "艾莉娜登场"       → `CG_DIR + "alyina_wake_sunset.png"`（夕阳醒来那一镜）
## ⚠️ **这里没有"沉入海底"那一张**：那是**开场 CG** 的图（见 `intro()`）——
##    用户 2026-09-20 纠正过一次，别再挪回来。
## 出图规范（二次元动漫画风、不是像素风）见 `request/09_ALYINA_CG_PROMPTS.md`。
##
## ⚠️ 图片缺了会自动退回纯色（`_apply_layer`），所以这几条改路径不会让游戏跑不起来。
##
## 镜头顺序严格照 `request/08_DIALOG.md`（"离开教学楼的一刻，触发一次性 cg"那一段）：
##   cg1 黑底白字 → cg2 主角抬头看天、小精灵掉下来 → cg3 「咚！」 → cg4 眼冒金星缓过来
##   （cg4 用"全白 → 淡入"模拟睁眼）→ 时间转下午四点、夕阳环境 → 与她搭话 → 跟上来。
static func alyina_fall() -> Array:
	return [
		{
			# 08："（停止音乐）" —— 这一段是"出楼那一刻"的一次性演出，
			# 音乐由 `alyina_cg.gd` 在进场景时停掉（数据文件不碰全局状态）。
			# 08 自己标的就是"黑底白字"，所以走 `blackout`（黑底白字字幕）：
			# 一句一句浮出、各停一会，比"一块旁白压 1.6 秒"更像过场。
			"shot_name": "cg1 · 黑底白字",
			"bg": Color(0.0, 0.0, 0.0),
			"blackout": [
				{"text": "你刚离开教学楼，就感觉有什么东西在朝你迫近。", "hold": 2.4},
				{"text": "你抬起了头。", "hold": 1.8},
			],
			"fade": 1.0,
		},
		{
			"shot_name": "cg2 · 天上掉下来的东西",
			"bg": CG_DIR + "alyina_fall_object.png",
			"fade": 1.2,
			"dialogue": [
				{"speaker": "", "text": "天上有个小小的东西，正笔直地朝你砸下来。"},
				{"speaker": "艾莉娜", "text": "哇呀——！", "emotion": "惊叫"},
				{"speaker": "周明远", "text": "？", "emotion": "懵"},
			],
		},
		{
			"shot_name": "cg3 · 「咚！」",
			"bg": CG_DIR + "alyina_impact.png",
			"text": "咚！",
			"sfx": SFX_IMPACT,
			# ⚠️ **用户 2026-09-20 实报"艾莉娜登场的咚的 cg 过的太快了"**。
			#    实测这一镜原来只占 **37 帧 ≈ 0.6 秒**（`hold 0.5` + `fade 0.10`）——
			#    白闪一下、"咚！"两个字还没看清就过去了，冲击感根本立不住。
			#    现在给到 **1.8s**（≈108 帧），让"被砸中"这个瞬间停得住。
			#    ⚠️ 别把 `fade` 一起调大：`fade` 是"从上一镜淡入"，它短才有"砸上来"的突然感；
			#       真正要长的是**停住的那一下**（`hold`）。
			#    走查里有一条断言守着它（`tools/cg_intro_probe.gd`：hold ≥ 1.2s 且实测帧数达标）。
			"hold": 1.8,
			"flash": true,
			"fade": 0.10,
		},
		{
			# 08 的 cg4："不知过了多久，你才从眼冒金星的状态缓过来。（模拟睁开眼睛的过程）"。
			# 用一张带柔焦/失焦效果的二次元过渡图承接白闪，再进入夕阳全景，
			# 避免冲击镜头后突然跳到纯色占位。
			"shot_name": "cg4 · 缓过来（睁眼）",
			"bg": CG_DIR + "alyina_recover.png",
			"fade": 2.0,
			"dialogue": [
				{"speaker": "", "text": "不知过了多久，你才从眼冒金星的状态缓过来。"},
				{"speaker": "周明远", "text": "……嘶。什么东西……", "emotion": "发懵"},
			],
		},
		{
			# 08："（时间转为下午四点，转为夕阳环境）"。
			# ⚠️ 这里只改**画面**；时钟本身由 `alyina_cg.gd` 拨到 16:00，
			#    数据文件不碰全局状态（与上面"停止音乐"同一条纪律）。
			# 这一镜与下一镜（艾莉娜登场）**共用同一张图**：她们本来就是同一个场景的连续镜头。
			"shot_name": "夕阳 · 醒来",
			"bg": CG_DIR + "alyina_wake_sunset.png",
			"fade": 1.6,
			"dialogue": [
				{"speaker": "", "text": "天已经斜了，光变成一层橘色，落在空无一人的路上。"},
				{"speaker": "周明远", "text": "（……我睡了多久？）", "emotion": "发懵"},
			],
			"hold": 0.6,
		},
		{
			"shot_name": "艾莉娜登场",
			"bg": CG_DIR + "alyina_wake_sunset.png",
			"dialogue": [
				{"speaker": "", "text": "脚边飘着一个巴掌大的……女孩子？"},
				{"speaker": "", "text": "不对，你定睛一看 —— 那是一个会飞的精灵。"},
				{"speaker": "", "text": "这时，小精灵飞了起来。"},
				# ⚠️ 她**自报名字之前**，名牌上写的是"小精灵？"（用户 2026-09-20 的要求）——
				#    08 在这一段里也一直是这么标的（"小精灵？（此时的对话框名字）"）。
				#    判据就是"她还没说出'我叫艾莉娜'"：从她说出名字的下一句起才换成艾莉娜。
				{"speaker": "小精灵？", "text": "我这是在哪里……呜哇！你没事吧！", "emotion": "慌张"},
				{"speaker": "周明远", "text": "被你陨星撞地球这么一下，能没事的可以当钢铁侠了。",
					"emotion": "没好气"},
				{"speaker": "小精灵？",
					"text": "对不起对不起！我也不知道为什么就突然从天上掉下来了，然后就到这里了……",
					"emotion": "道歉"},
				{"speaker": "周明远", "text": "你不知道你之前发生什么了吗？", "emotion": "追问"},
				{"speaker": "小精灵？",
					"text": "我什么都不记得了……只记得自己的名字叫艾莉娜，还有什么……重要的任务？但是我记不清了。",
					"emotion": "困惑"},
				{"speaker": "小精灵？", "text": "所以这里是哪里？你又是谁？", "emotion": "好奇"},
				{"speaker": "周明远",
					"text": "我叫周明远，这里是我就读的大学校园，我刚准备去图书馆写论文就被你砸中了。",
					"emotion": "无奈"},
				{"speaker": "周明远", "text": "不管怎样，我可以叫你艾莉娜，对吧？", "emotion": "认命"},
				{"speaker": "艾莉娜", "text": "对的对的！那我叫你粥粥可以吗？", "emotion": "雀跃"},
				{"speaker": "周明远", "text": "（笑）你还真机灵，粥粥就是我的小名，不过我基本没和别人说过。",
					"emotion": "意外"},
				{"speaker": "艾莉娜", "text": "粥粥先生，那我可以暂时跟你生活一段时间吗？", "emotion": "期待"},
				{"speaker": "周明远",
					"text": "好啊，反正估计你也不需要吃饭喝水，就跟着我吧，正好我也没什么朋友。",
					"emotion": "随口"},
				{"speaker": "艾莉娜", "text": "好耶！", "emotion": "开心"},
				{"speaker": "", "text": "艾莉娜加入了你的队伍。"},
			],
		},
		{
			"shot_name": "跟上来",
			"bg": CG_DIR + "alyina_wake_sunset.png",
			# ⚠️ **这里故意没有台词**（用户 2026-09-20："毕业论文少写一天不少这段话应该是
			#    cg 播放结束后触发的，不应该在 cg 对话里"）。
			#    原来这三句（"毕业论文少写一天不少…" / "哇，感谢粥粥…" / "也算是我第一次…"）
			#    挂在这一镜的 `dialogue` 上，等于**还压在 CG 画面里**；
			#    08 的编排是：她"加入了你的队伍" → 这三句 → "任务更新：带着艾莉娜在校园逛逛"。
			#    "加入队伍"这件事是**在校园里**发生的（CG 结束、回到地图之后），
			#    所以这三句也应该是落地后说的 —— 现在放在 `alyina_landing_lines()`，
			#    由 `StoryData.maybe_play_alyina_tour()` 在回到校园时播（播完才算"这一段收了"）。
			#    ⚠️ 别把 `dialogue` 加回来：那样地上和 CG 里会各说一遍。
			"hold": 1.0,
		},
	]


## 艾莉娜登场 CG **播完、回到地图之后**才说的那三句（08_DIALOG.md 307~311 行）。
##
## 为什么单独拿出来、而不是留在上面那一镜里：见 `alyina_fall()` 末尾的说明 ——
## 用户 2026-09-20 明确"这段应该是 cg 播放结束后触发的"。
##
## 播放点：`StoryData.maybe_play_alyina_tour()`（在 `CollegeMap._check_story_triggers()` 里
