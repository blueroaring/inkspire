static func entries() -> Dictionary:
	var result := {}
	for id in STATUS.DEFINITIONS:
		var status: Dictionary = STATUS.DEFINITIONS[id]
		result[String(status.name)] = {"kind":"状态效果", "desc":String(status.desc)}
	for term in EXTRA:
		result[term] = {"kind":"状态效果", "desc":String(EXTRA[term])}
	for term in ["反抗援助", "被攻击计数", "木马", "边缘值", "希望"]:
		result[term].kind = "战斗规则"
	for id in CARD_IDS:
		var card := FightData.skill(id)
		result[String(card.name)] = {"kind":"卡牌", "desc":FightData.description(id), "card_id":id}
	return result
