static func ids() -> Array:
	return ENTRIES.keys()

static func entry(id: String) -> Dictionary:
	id = String(ALIASES.get(id, id))
	if not ENTRIES.has(id): return {}
	var result: Dictionary = ENTRIES[id].duplicate(true)
	if id == "inverse_limit" and TowerRun.active:
		result.mechanics += " 尖塔调整：潮湿施加的脆弱最多3层；暴雨倾盆最多追加3段群攻。"
	result["assists"] = ASSISTS.get(id, []).duplicate(true)
	result["recommendation"] = recommendation(id)
	var profile := FightData.enemy(id)
	result.merge({"id":id, "name":profile.name, "portrait":profile.portrait, "attribute":profile.attribute})
	return result
